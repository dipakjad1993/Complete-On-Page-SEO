# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# Path to system Chrome/Chromium (Docker sets this automatically).
CHROME_PATH=
# Comma-separated allowed browser origins. Empty = allow all (public demo).
ALLOWED_ORIGINS=
# Public URL of this instance (used for keep-alive self-ping docs).
KEEP_ALIVE_URL=http://localhost:3000/api/health
# Optional: Google PageSpeed API key for higher /api/crux quota (works without).
PAGESPEED_API_KEY=
