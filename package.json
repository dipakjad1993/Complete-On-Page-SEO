{
  "name": "complete-on-page-seo-2026",
  "version": "1.3.0",
  "description": "Production-grade 22-level on-page + AI-search (RAG/LLM) SEO auditor with 14 dev-ready deliverables - real measured data, no mocks. Node.js + Puppeteer + Express.",
  "main": "server.js",
  "bin": {
    "complete-on-page-seo": "./bin/seo-audit.js",
    "seo-audit": "./bin/seo-audit.js"
  },
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "watch": "nodemon --watch . -e js,json,html server.js",
    "cli": "node bin/seo-audit.js",
    "mcp": "node mcp-server.js",
    "render-build": "npm install && npx puppeteer browsers install chrome",
    "postinstall": "node -e \"try { require('puppeteer').executablePath(); } catch(e) { console.log('Puppeteer Chrome will be downloaded on first run or via render-build'); }\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "typecheck": "node --check server.js && node --check helpers.js && node --check levels.js && node --check src/levels/level22.js && node --check mcp-server.js && node --check bin/seo-audit.js"
  },
  "keywords": [
    "seo",
    "audit",
    "on-page",
    "on-page-seo",
    "technical-seo",
    "ai-seo",
    "rag",
    "llm",
    "aeo",
    "geo",
    "llms-txt",
    "mcp",
    "puppeteer",
    "cheerio",
    "expressjs",
    "core-web-vitals",
    "crux",
    "edge-computing",
    "seo-tools",
    "site-audit",
    "javascript",
    "nodejs"
  ],
  "author": "Dipak Jadhav (https://github.com/dipakjad1993)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dipakjad1993/Complete-On-Page-SEO.git"
  },
  "bugs": {
    "url": "https://github.com/dipakjad1993/Complete-On-Page-SEO/issues"
  },
  "homepage": "https://complete-on-page-seo.onrender.com/",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "compromise": "^14.16.0",
    "cors": "^2.8.6",
    "css-select": "^7.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-fetch": "^2.7.0",
    "puppeteer": "^25.11.0",
    "schema-dts": "^2.0.0",
    "terser": "^5.49.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "vitest": "^5.0.0",
    "supertest": "^7.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.4.2"
  }
}
